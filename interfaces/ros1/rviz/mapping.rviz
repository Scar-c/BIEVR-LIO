Panels:
  - Class: rviz/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 1239
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 40
      Plane Cell Size: 1
      Plane Color: 160; 160; 164
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 1
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Enabled: true
      Keep: 1000
      Name: Odometry
      Position Tolerance: 0.1
      Queue Size: 10
      Shape:
        Alpha: 1
        Axes Length: 2
        Axes Radius: 0.2
        Color: 255; 25; 0
        Value: true
      Topic: /bievr_lio/odom
      Value: true
    - Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Decay Time: 0
      Enabled: true
      Name: Accumulated Map
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic: /bievr_lio/points/registered
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Themed Colored: true
      Topic: /initialpose
    - Class: rviz/SetGoal
      Themed Colored: true
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Themed Colored: true
      Topic: /clicked_point
  Views:
    Current: "rviz/Orbit - 0"
    Saved: ~
